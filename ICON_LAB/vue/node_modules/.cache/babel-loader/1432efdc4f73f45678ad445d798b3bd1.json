Error","err","_err$response","message"],"sources":["src/views/front/Stylize.vue"],"sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <h1>🎨 艺术风格迁移</h1>\r\n\r\n    <div class=\"upload-section\">\r\n      <!-- 内容图片上传 -->\r\n      <div class=\"upload-box\">\r\n        <h2>内容图片</h2>\r\n        <div class=\"preview-container\" @click=\"triggerContentInput\">\r\n          <img class=\"preview-img\" :src=\"contentPreview\" v-if=\"contentPreview\">\r\n          <div class=\"upload-label\" v-else>\r\n            <i>📷</i>\r\n            点击上传内容图片\r\n          </div>\r\n          <input type=\"file\" ref=\"contentInput\" accept=\"image/*\" @change=\"handleContentUpload\" hidden>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 风格图片上传 -->\r\n      <div class=\"upload-box\">\r\n        <h2>风格图片</h2>\r\n        <div class=\"preview-container\" @click=\"triggerStyleInput\">\r\n          <img class=\"preview-img\" :src=\"stylePreview\" v-if=\"stylePreview\">\r\n          <div class=\"upload-label\" v-else>\r\n            <i>🎨</i>\r\n            点击上传风格图片\r\n          </div>\r\n          <input type=\"file\" ref=\"styleInput\" accept=\"image/*\" @change=\"handleStyleUpload\" hidden>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <button @click=\"processImages\" :disabled=\"processing\">\r\n      {{ processing ? '处理中...' : '开始风格迁移' }}\r\n    </button>\r\n\r\n    <div class=\"loading\" v-if=\"processing\">🔄 正在处理中，请稍候...</div>\r\n    <div class=\"error\" v-if=\"error\">❌ {{ error }}</div>\r\n\r\n    <!-- 结果展示 -->\r\n    <div class=\"result-section\" v-if=\"resultUrl\">\r\n      <h2>生成结果</h2>\r\n      <img class=\"result-img\" :src=\"resultUrl\">\r\n      <a class=\"download-btn\" :href=\"resultUrl\" download>下载结果</a>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      contentFile: null,\r\n      styleFile: null,\r\n      contentPreview: null,\r\n      stylePreview: null,\r\n      processing: false,\r\n      error: null,\r\n      resultUrl: null\r\n    };\r\n  },\r\n  methods: {\r\n    triggerContentInput() {\r\n      this.$refs.contentInput.click();\r\n    },\r\n    triggerStyleInput() {\r\n      this.$refs.styleInput.click();\r\n    },\r\n    handleContentUpload(e) {\r\n      const file = e.target.files[0];\r\n      if (file) {\r\n        this.contentFile = file;\r\n        this.previewImage(file, \"content\");\r\n      }\r\n    },\r\n    handleStyleUpload(e) {\r\n      const file = e.target.files[0];\r\n      if (file) {\r\n        this.styleFile = file;\r\n        this.previewImage(file, \"style\");\r\n      }\r\n    },\r\n    previewImage(file, type) {\r\n      const reader = new FileReader();\r\n      reader.onload = (e) => {\r\n        if (type === \"content\") {\r\n          this.contentPreview = e.target.result;\r\n        } else {\r\n          this.stylePreview = e.target.result;\r\n        }\r\n      };\r\n      reader.readAsDataURL(file);\r\n    },\r\n    async processImages() {\r\n      this.error = null;\r\n      this.resultUrl = null;\r\n\r\n      if (!this.contentFile || !this.styleFile) {\r\n        this.error = \"请先上传内容和风格图片\";\r\n        return;\r\n      }\r\n\r\n      this.processing = true;\r\n      console.log(\"📤 开始上传文件...\");\r\n\r\n      try {\r\n        const formData = new FormData();\r\n        formData.append(\"content\", this.contentFile);\r\n        formData.append(\"style\", this.styleFile);\r\n\r\n        // ✅ 让用户看到请求正在发送\r\n        console.log(\"📝 发送的数据:\", formData.get(\"content\"), formData.get(\"style\"));\r\n\r\n        // ✅ 发送请求（尝试代理，否则直接访问 Flask）\r\n        const response = await axios.post(\"/stylize\", formData, {\r\n          headers: { \"Content-Type\": \"multipart/form-data\" },\r\n          timeout: 10000  // 10 秒超时\r\n        });\r\n\r\n        console.log(\"✅ 后端响应:\", response.data);\r\n\r\n        if (response.data.status === \"success\") {\r\n          this.resultUrl = response.data.output_url;\r\n        } else {\r\n          throw new Error(response.data.error || \"处理失败\");\r\n        }\r\n      } catch (err) {\r\n        console.error(\"❌ 请求失败:\", err);\r\n        this.error = err.response?.data?.error || err.message || \"未知错误\";\r\n      } finally {\r\n        this.processing = false;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 2rem;\r\n}\r\n\r\n.upload-section {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 2rem;\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.upload-box {\r\n  background: white;\r\n  border-radius: 12px;\r\n  padding: 2rem;\r\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\r\n  transition: transform 0.2s;\r\n}\r\n\r\n.preview-container {\r\n  position: relative;\r\n  width: 100%;\r\n  aspect-ratio: 1;\r\n  border: 2px dashed #bdc3c7;\r\n  border-radius: 8px;\r\n  margin: 1rem 0;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n}\r\n\r\n.preview-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.upload-label {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  color: #7f8c8d;\r\n}\r\n\r\ninput[type=\"file\"] {\r\n  display: none;\r\n}\r\n\r\nbutton {\r\n  background: #3498db;\r\n  color: white;\r\n  border: none;\r\n  padding: 1rem 2rem;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-size: 1.1rem;\r\n  transition: background 0.3s;\r\n  display: block;\r\n  margin: 0 auto;\r\n}\r\n\r\nbutton:hover {\r\n  background: #2980b9;\r\n}\r\n\r\n.result-section {\r\n  text-align: center;\r\n  margin-top: 2rem;\r\n}\r\n\r\n.result-img {\r\n  max-width: 600px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\r\n  margin: 1rem 0;\r\n}\r\n\r\n.download-btn {\r\n  display: inline-block;\r\n  background: #2ecc71;\r\n  color: white;\r\n  padding: 0.8rem 1.5rem;\r\n  border-radius: 8px;\r\n  text-decoration: none;\r\n  margin-top: 1rem;\r\n  transition: background 0.3s;\r\n}\r\n\r\n.download-btn:hover {\r\n  background: #27ae60;\r\n}\r\n\r\n.loading {\r\n  text-align: center;\r\n  color: #3498db;\r\n  margin: 1rem 0;\r\n}\r\n\r\n.error {\r\n  color: #e74c3c;\r\n  text-align: center;\r\n  margin: 1rem 0;\r\n  font-weight: bold;\r\n}\r\n</style>\r\n"],"mappings":";AAiDA,OAAAA,KAAA;AAEA;EACAC,KAAA;IACA;MACAC,WAAA;MACAC,SAAA;MACAC,cAAA;MACAC,YAAA;MACAC,UAAA;MACAC,KAAA;MACAC,SAAA;IACA;EACA;EACAC,OAAA;IACAC,oBAAA;MACA,KAAAC,KAAA,CAAAC,YAAA,CAAAC,KAAA;IACA;IACAC,kBAAA;MACA,KAAAH,KAAA,CAAAI,UAAA,CAAAF,KAAA;IACA;IACAG,oBAAAC,CAAA;MACA,MAAAC,IAAA,GAAAD,CAAA,CAAAE,MAAA,CAAAC,KAAA;MACA,IAAAF,IAAA;QACA,KAAAhB,WAAA,GAAAgB,IAAA;QACA,KAAAG,YAAA,CAAAH,IAAA;MACA;IACA;IACAI,kBAAAL,CAAA;MACA,MAAAC,IAAA,GAAAD,CAAA,CAAAE,MAAA,CAAAC,KAAA;MACA,IAAAF,IAAA;QACA,KAAAf,SAAA,GAAAe,IAAA;QACA,KAAAG,YAAA,CAAAH,IAAA;MACA;IACA;IACAG,aAAAH,IAAA,EAAAK,IAAA;MACA,MAAAC,MAAA,OAAAC,UAAA;MACAD,MAAA,CAAAE,MAAA,GAAAT,CAAA;QACA,IAAAM,IAAA;UACA,KAAAnB,cAAA,GAAAa,CAAA,CAAAE,MAAA,CAAAQ,MAAA;QACA;UACA,KAAAtB,YAAA,GAAAY,CAAA,CAAAE,MAAA,CAAAQ,MAAA;QACA;MACA;MACAH,MAAA,CAAAI,aAAA,CAAAV,IAAA;IACA;IACA,MAAAW,cAAA;MACA,KAAAtB,KAAA;MACA,KAAAC,SAAA;MAEA,UAAAN,WAAA,UAAAC,SAAA;QACA,KAAAI,KAAA;QACA;MACA;MAEA,KAAAD,UAAA;MACAwB,OAAA,CAAAC,GAAA;MAEA;QACA,MAAAC,QAAA,OAAAC,QAAA;QACAD,QAAA,CAAAE,MAAA,iBAAAhC,WAAA;QACA8B,QAAA,CAAAE,MAAA,eAAA/B,SAAA;;QAEA;QACA2B,OAAA,CAAAC,GAAA,cAAAC,QAAA,CAAAG,GAAA,aAAAH,QAAA,CAAAG,GAAA;;QAEA;QACA,MAAAC,QAAA,SAAApC,KAAA,CAAAqC,IAAA,aAAAL,QAAA;UACAM,OAAA;YAAA;UAAA;UACAC,OAAA;QACA;QAEAT,OAAA,CAAAC,GAAA,YAAAK,QAAA,CAAAnC,IAAA;QAEA,IAAAmC,QAAA,CAAAnC,IAAA,CAAAuC,MAAA;UACA,KAAAhC,SAAA,GAAA4B,QAAA,CAAAnC,IAAA,CAAAwC,UAAA;QACA;UACA,UAAAC,KAAA,CAAAN,QAAA,CAAAnC,IAAA,CAAAM,KAAA;QACA;MACA,SAAAoC,GAAA;QAAA,IAAAC,aAAA;QACAd,OAAA,CAAAvB,KAAA,YAAAoC,GAAA;QACA,KAAApC,KAAA,KAAAqC,aAAA,GAAAD,GAAA,CAAAP,QAAA,cAAAQ,aAAA,gBAAAA,
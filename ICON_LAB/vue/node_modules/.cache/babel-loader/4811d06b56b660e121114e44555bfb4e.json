error => {\n        this.$message.error(\"请求异常：\" + error.message);\n      });\n    },\n    handlePopoverClose() {\n      // 强制将焦点移出弹出框\n      document.activeElement.blur();\n    },\n    handleSelectionChange(val) {\n      this.multipleSelection = val\n    },\n    delBatch() {\n      let ids = this.multipleSelection.map(v => v.id)  // [{}, {}, {}] => [1,2,3]\n      this.request.post(\"/user/del/batch\", ids).then(res => {\n        if (res.code === '200') {\n          this.$message.success(\"批量删除成功\")\n          this.load()\n        } else {\n          this.$message.error(\"批量删除失败\")\n        }\n      })\n    },\n    reset() {\n      this.role = \"\"\n      this.nickname = \"\"\n      this.email = \"\"\n      this.address = \"\"\n      this.load()\n    },\n    handleSizeChange(pageSize) {\n      this.pageSize = pageSize\n      this.load()\n    },\n    handleCurrentChange(pageNum) {\n      this.pageNum = pageNum\n      this.load()\n    },\n    handleImgUploadSuccess(res) {\n      this.form.avatarUrl = res\n    },\n  }\n}\n</script>\n\n<style scoped>\n.el-popover[aria-hidden=\"true\"] {\n  display: none !important;\n}\n</style>\n"],"mappings":";;AAuIA,SAAAA,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAF,UAAA,EAAAA,UAAA;MACAG,SAAA;MACAC,KAAA;MACAC,OAAA;MACAC,QAAA;MACAC,IAAA;MACAC,QAAA;MACAC,KAAA;MACAC,OAAA;MACAC,IAAA;MACAC,iBAAA;MACAC,iBAAA;MACAC,KAAA,GACA;QAAAC,KAAA;QAAAC,IAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,IAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,KAAAE,OAAA,CAAAC,GAAA;QACAC,MAAA;UACAjB,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAC,IAAA,OAAAA,IAAA;UACAC,QAAA,OAAAA,QAAA;UACAC,KAAA,OAAAA,KAAA;UACAC,OAAA,OAAAA;QACA;MACA,GAAAa,IAAA,CAAAC,GAAA;QAEA,KAAArB,SAAA,GAAAqB,GAAA,CAAAtB,IAAA,CAAAuB,OAAA;QACA,KAAArB,KAAA,GAAAoB,GAAA,CAAAtB,IAAA,CAAAE,KAAA;MAEA;IACA;IACAsB,KAAA;MACA,KAAAN,OAAA,CAAAO,IAAA,eAAAhB,IAAA,EAAAY,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAI,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAlB,iBAAA;UACA,KAAAM,IAAA;QACA;UACA,KAAAW,QAAA,CAAAE,KAAA;
","colorList","dataIndex","map","v","value"],"sources":["src/views/Echarts.vue"],"sourcesContent":["<template>\r\n  <div >\r\n\r\n    <el-row :gutter=\"24\">\r\n\r\n      <el-col :span=\"12\" style=\"margin-top: 20px;display: flex;justify-content: space-around\">\r\n        <el-card style=\"width: 100%;font-size: 20px\">\r\n          <i class=\"el-icon-user\"></i>\r\n          <span>用户数量:{{userCount}}</span>\r\n        </el-card>\r\n      </el-col>\r\n\r\n      <el-col :span=\"12\" style=\"margin-top: 20px;display: flex;justify-content: space-around\">\r\n        <el-card style=\"width: 100%;font-size: 20px\">\r\n          <i class=\"el-icon-picture-outline\"></i>\r\n          <span>作品数量:{{creationCount}}</span>\r\n        </el-card>\r\n      </el-col>\r\n\r\n    </el-row>\r\n\r\n\r\n    <el-row :gutter=\"24\" style=\"margin-top: 50px\">\r\n\r\n      <el-col :span=\"12\" style=\"margin-top: 20px;display: flex;justify-content: space-around\">\r\n        <div id=\"main1\" style=\"width: 100%; height: 600px\"></div>\r\n      </el-col>\r\n\r\n      <el-col :span=\"12\" style=\"margin-top: 20px;display: flex;justify-content: space-around\">\r\n        <div id=\"main2\" style=\"width: 100%; height: 600px\"></div>\r\n      </el-col>\r\n\r\n    </el-row>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nimport * as echarts from 'echarts';\r\n\r\nexport default {\r\n  name: \"Home\",\r\n  data() {\r\n    return {\r\n      userCount:0,\r\n      creationCount:0,\r\n    };\r\n  },\r\n  created() {\r\n    this.request.get('/user').then(res=>{\r\n      this.userCount=res.data.filter(user=>user.role==='ROLE_USER').length\r\n    })\r\n    this.request.get('/creation').then(res=>{\r\n      this.creationCount=res.data.length\r\n    })\r\n  },\r\n  mounted() {\r\n\r\n    const chartDom1 = document.getElementById('main1');\r\n    const myChart1 = echarts.init(chartDom1);\r\n    let option1;\r\n\r\n    option1 = {\r\n      title: {\r\n        text: '不同分类图片作品数量饼图',\r\n        subtext: '饼图',\r\n        left: 'center'\r\n      },\r\n      tooltip: {\r\n        trigger: 'item'\r\n      },\r\n      legend: {\r\n        orient: 'vertical',\r\n        left: 'left'\r\n      },\r\n      series: [\r\n        {\r\n          name: 'Access From',\r\n          type: 'pie',\r\n          radius: '50%',\r\n          data: [],\r\n          emphasis: {\r\n            itemStyle: {\r\n              shadowBlur: 10,\r\n              shadowOffsetX: 0,\r\n              shadowColor: 'rgba(0, 0, 0, 0.5)'\r\n            }\r\n          }\r\n        }\r\n      ]\r\n    };\r\n\r\n    this.request.get(\"/creation/count1\").then(res=>{\r\n      res.data.forEach(item=>{\r\n        option1.series[0].data.push(item)\r\n      })\r\n      option1 && myChart1.setOption(option1);\r\n    })\r\n\r\n\r\n    const chartDom2 = document.getElementById('main2');\r\n    const myChart2 = echarts.init(chartDom2);\r\n    let option2;\r\n\r\n    option2 = {\r\n      title: {\r\n        text: '热门作者积分排行top5柱状图',\r\n        subtext: '柱状图',\r\n        left: 'center'\r\n      },\r\n      tooltip: {\r\n        trigger: 'item'\r\n      },\r\n      legend: {\r\n        orient: 'vertical',\r\n        left: 'left'\r\n      },\r\n      xAxis: {\r\n        type: 'category',\r\n        data: [],\r\n        axisLabel: {\r\n          interval: 0, // 或者设置为大于1的整数\r\n        }\r\n      },\r\n      yAxis: {\r\n        type: 'value'\r\n      },\r\n      series: [\r\n        {\r\n          data: [],\r\n          type: 'bar',\r\n          itemStyle: {\r\n            normal: {\r\n              color: function (params) {\r\n                const colorList = [\r\n                  '#C1232B', '#B5C334', '#FCCE10', '#E87C25', '#27727B',\r\n                  '#FE8463', '#9BCA63', '#FAD860', '#F3A43B', '#60C0DD',\r\n                  '#D7504B', '#C6E579', '#F4E001', '#F0805A', '#26C0C0'\r\n                ];\r\n                return colorList[params.dataIndex]\r\n              },\r\n            }\r\n          }\r\n        },\r\n      ]\r\n    };\r\n\r\n    this.request.get(\"/creation/count2\").then(res => {\r\n      option2.xAxis.data = res.data.map(v => v.name)\r\n      option2.series[0].data = res.data.map(v => v.value)\r\n      myChart2.setOption(option2);\r\n    })\r\n\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n\r\n"],"mappings":";;;;;AAuCA,YAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,OAAA,CAAAC,GAAA,UAAAC,IAAA,CAAAC,GAAA;MACA,KAAAN,SAAA,GAAAM,GAAA,CAAAP,IAAA,CAAAQ,MAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,IAAA,kBAAAC,MAAA;IACA;IACA,KAAAP,OAAA,CAAAC,GAAA,cAAAC,IAAA,CAAAC,GAAA;MACA,KAAAL,aAAA,GAAAK,GAAA,CAAAP,IAAA,CAAAW,MAAA;IACA;EACA;EACAC,QAAA;IAEA,MAAAC,SAAA,GAAAC,QAAA,CAAAC,cAAA;IACA,MAAAC,QAAA,GAAAlB,OAAA,CAAAmB,IAAA,CAAAJ,SAAA;IACA,IAAAK,OAAA;IAEAA,OAAA;MACAC,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,IAAA;MACA;MACAC,OAAA;QACAC,OAAA;MACA;MACAC,MAAA;QACAC,MAAA;QACAJ,IAAA;MACA;MACAK,MAAA,GACA;QACA5B,IAAA;QACA6B,IAAA;QACAC,MAAA;QACA7B,IAAA;QACA8B,QAAA;UACAC,SAAA;YACAC,UAAA;YACAC,aAAA;YACAC,WAAA;UACA;QACA;MACA;IAEA;IAEA,KAAA9B,OAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;MACAA,GAAA,CAAAP,IAAA,CAAAmC,OAAA,CAAAC,IAAA;QACAlB,OAAA,CAAAS,MAAA,IAAA3B,IAAA,CAAAqC,IAAA,CAAAD,IAAA;MACA;MACAlB,OAAA,IAAAF,QAAA,CAAAsB,SAAA,CAAApB,OAAA;IACA;IAGA,MAAAqB,SAAA,GAAAzB,QAAA,CAAAC,cAAA;IACA,MAAAyB,QAAA,GAAA1C,OAAA,CAAAmB,IAAA,CAAAsB,SAAA;IACA,IAAAE,OAAA;IAEAA,OAAA;MACAtB,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,IAAA;MACA;MACAC,OAAA;QACAC,OAAA;MACA;MACAC,MAAA;QACAC,MAAA;QACAJ,IAAA;MACA;MACAoB,KAAA;QACAd,IAAA;QACA5B,IAAA;QACA2C,SAAA;UACAC,QAAA;QACA;MACA;MACAC,KAAA;QACAjB,IAAA;MACA;MACAD,MAAA,GACA;QACA3B,IAAA;QACA4B,IAAA;QACAG,SAAA;UACAe,MAAA;YACAC,KAAA,WAAAA,CAAAC,MAAA;cACA,MAAAC,SAAA,IACA,uDACA,uDACA,sDACA;cACA,OAAAA,SAAA,CAAAD,MAAA,CAAAE,SAAA;YACA;UACA;QACA;MACA;IAEA;IAEA,KAAA9C,OAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;MACAkC,OAAA,CAAAC,KAAA,CAAA1C,IAAA,GAAAO,GAAA,CAAAP,IAAA,CAAAmD,GAAA,CAAAC,CAAA,IAAAA,CAAA,CAAArD,IAAA;MACA0C,OAAA,CAAAd,MAAA,IAAA3B,IAAA
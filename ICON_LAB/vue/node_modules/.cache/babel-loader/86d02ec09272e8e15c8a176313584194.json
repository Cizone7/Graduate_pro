on\r\n          :icon=\"selectedIcon\"\r\n          :width=\"iconSize\"\r\n          :height=\"iconSize\"\r\n          :style=\"{\r\n          color: iconColor,\r\n          stroke: iconColor,\r\n          strokeWidth: iconStrokeWidth + 'px'\r\n        }\"\r\n      />\r\n\r\n      <div>\r\n        <label for=\"color-picker\">选择颜色:</label>\r\n        <input id=\"color-picker\" type=\"color\" v-model=\"iconColor\" />\r\n      </div>\r\n\r\n      <div>\r\n        <label for=\"size\">选择大小:</label>\r\n        <input id=\"size\" type=\"range\" min=\"20\" max=\"100\" v-model=\"iconSize\" />\r\n      </div>\r\n\r\n      <div>\r\n        <label for=\"stroke\">选择线条粗细:</label>\r\n        <input id=\"stroke\" type=\"range\" min=\"1\" max=\"10\" v-model=\"iconStrokeWidth\" />\r\n      </div>\r\n\r\n      <!-- 查看SVG代码框 -->\r\n      <div class=\"svg-code\">\r\n        <h3>SVG 代码</h3>\r\n        <textarea :value=\"computedSvgCode\" readonly></textarea>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Icon } from '@iconify/vue2';\r\nimport { getIconData } from '@iconify/utils'; // 获取 SVG 代码的方法\r\nimport { loadIcons } from '@iconify/vue2';\r\n\r\nexport default {\r\n  components: {\r\n    Icon,\r\n  },\r\n  data() {\r\n    return {\r\n      iconLibrary: 'line-md',\r\n      iconNames: ['account', 'account-add', 'account-alert', 'account-alert-loop', 'account-loop'],\r\n      visibleIcons: [],\r\n      selectedIcon: null,\r\n      iconColor: '#000000',\r\n      iconSize: 50,\r\n      iconStrokeWidth: 2,\r\n    };\r\n  },\r\n  created() {\r\n    this.loadIcons();\r\n  },\r\n  computed: {\r\n    computedSvgCode() {\r\n      if (!this.selectedIcon) return '';\r\n\r\n      const iconName = this.selectedIcon.split(':')[1];\r\n      const iconData = getIconData(this.iconLibrary, iconName);\r\n\r\n      if (!iconData) return '无法获取 SVG 数据';\r\n\r\n      return `\r\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"${iconData.viewBox}\"\r\n             width=\"${this.iconSize}px\" height=\"${this.iconSize}px\"\r\n             style=\"fill: ${this.iconColor}; stroke: ${this.iconColor}; stroke-width: ${this.iconStrokeWidth}px;\">\r\n          ${iconData.body}\r\n        </svg>\r\n      `;\r\n    },\r\n  },\r\n  methods: {\r\n    loadIcons() {\r\n      this.visibleIcons = this.iconNames.map(name => `${this.iconLibrary}:${name}`);\r\n      if (this.visibleIcons.length > 0) {\r\n        this.selectedIcon = this.visibleIcons[0]; // 默认选中第一个\r\n      }\r\n      loadIcons(this.visibleIcons);\r\n    },\r\n    selectIcon(icon) {\r\n      this.selectedIcon = icon;\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.icon-container {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.icon-item {\r\n  width: 60px;\r\n  height: 60px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease-in-out;\r\n}\r\n\r\n.icon-item:hover {\r\n  transform: scale(1.1);\r\n}\r\n\r\n.icon-item.selected {\r\n  border: 2px solid #007bff;\r\n  border-radius: 10px;\r\n  background-color: rgba(0, 123, 255, 0.1);\r\n}\r\n\r\n.preview-container {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.preview-container label {\r\n  display: block;\r\n  margin: 10px 0;\r\n}\r\n\r\n.svg-code {\r\n  margin-top: 20px;\r\n  text-align: left;\r\n  max-width: 600px;\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n}\r\n\r\n.svg-code textarea {\r\n  width: 100%;\r\n  height: 200px;\r\n  font-family: monospace;\r\n  white-space: pre-wrap;\r\n  word-wrap: break-word;\r\n  background-color: #f8f9fa;\r\n  border: 1px solid #ddd;\r\n  padding: 10px;\r\n  resize: none;\r\n}\r\n</style>\r\n"],"mappings":";;AAsDA,SAAAA,IAAA;AACA,SAAAC,WAAA;AACA,SAAAC,SAAA;AAEA;EACAC,UAAA;IACAH;EACA;EACAI,KAAA;IACA;MACAC,WAAA;MACAC,SAAA;MACAC,YAAA;MACAC,YAAA;MACAC,SAAA;MACAC,QAAA;MACAC,eAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAV,SAAA;EACA;EACAW,QAAA;IACAC,gBAAA;MACA,UAAAN,Y
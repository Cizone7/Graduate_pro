-button type=\"info\" plain @click=\"reset\">重置</el-button>\r\n    </div>\r\n\r\n    <!-- 数据表格 -->\r\n    <el-card>\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\r\n        <el-table-column label=\"用户昵称\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <span v-if=\"scope.row.userId\">\r\n              {{ users.find(v => v.id === scope.row.userId)?.nickname || '未知用户' }}\r\n            </span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"amount\" label=\"充值金额\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            ￥{{ scope.row.amount.toFixed(2) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"points\" label=\"获得积分\" align=\"center\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"状态\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <el-tag :type=\"scope.row.status === 'SUCCESS' ? 'success' : 'danger'\">\r\n              {{ scope.row.status }}\r\n            </el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"createTime\" label=\"充值时间\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            {{ formatTime(scope.row.createTime) }}\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!-- 分页 -->\r\n      <div style=\"padding: 10px 0\">\r\n        <el-pagination\r\n            @size-change=\"handleSizeChange\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :current-page=\"pageNum\"\r\n            :page-sizes=\"[5, 10, 20, 50]\"\r\n            :page-size=\"pageSize\"\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :total=\"total\"\r\n        ></el-pagination>\r\n      </div>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport dayjs from 'dayjs'\r\n\r\nexport default {\r\n  name: \"Record\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      users: [],\r\n      total: 0,\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      searchAmount: \"\", // 搜索条件\r\n      searchNickname: \"\",\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n    this.request.get('/user').then(res => {\r\n      this.users = res.data\r\n    })\r\n  },\r\n  methods: {\r\n    formatTime(time) {\r\n      return time ? dayjs(time).format('YYYY-MM-DD HH:mm') : ''\r\n    },\r\n    // 加载数据\r\n    load() {\r\n      this.request.get(\"/record/page\", {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          amount: this.searchAmount,\r\n          nickname: this.searchNickname,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data.records\r\n        this.total = res.data.total\r\n      })\r\n    },\r\n    // 重置搜索\r\n    reset() {\r\n      this.searchAmount = \"\"\r\n      this.searchNickname = \"\"\r\n      this.load()\r\n    },\r\n    // 分页方法\r\n    handleSizeChange(pageSize) {\r\n      this.pageSize = pageSize\r\n      this.load()\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.pageNum = pageNum\r\n      this.load()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.ml-5 {\r\n  margin-left: 5px;\r\n}\r\n</style>"],"mappings":"AAoEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,KAAA;MACAC,KAAA;MACAC,OAAA;MACAC,QAAA;MACAC,YAAA;MAAA;MACAC,cAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;IACA,KAAAC,OAAA,CAAAC,GAAA,UAAAC,IAAA,CAAAC,GAAA;MACA,KAAAX,KAAA,GAAAW,GAAA,CAAAb,IAAA;IACA;EACA;EACAc,OAAA;IACAC,WAAAC,IAAA;MACA,OAAAA,IAAA,GAAAlB,KAAA,CAAAkB,IAAA,EAAAC,MAAA;IACA;IACA;IACAR,KAAA;MACA,KAAAC,OAAA,CAAAC,GAAA;QACAO,MAAA;UACAd,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAc,MAAA,OAAAb,YAAA;UACAc,QAAA,OAAAb;QACA;MACA,GAAAK,IAAA,CAAAC,GAAA;QACA,KAAAZ,SAAA,GAAAY,GAAA,CAAAb,IAAA,CAAAqB,OAAA;QACA,KAAAlB,KAAA,GAAAU,GAAA,CAAAb,IAAA
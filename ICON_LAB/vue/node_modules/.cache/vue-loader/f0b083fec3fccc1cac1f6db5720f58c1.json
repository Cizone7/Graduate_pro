{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\Record.vue?vue&type=style&index=0&id=4917ee8b&scoped=true&lang=css","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\Record.vue","mtime":1743524645467},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\css-loader\\dist\\cjs.js","mtime":1741692740692},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1741692741778},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\postcss-loader\\src\\index.js","mtime":1741692741656},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Record.vue"],"names":[],"mappings":";AAgGA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"Record.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div class=\"recharge-container\">\r\n    <el-card class=\"recharge-card\">\r\n      <div slot=\"header\" class=\"header\">\r\n        <span>积分充值</span>\r\n        <span class=\"current-points\">当前积分：{{ user.count }}</span>\r\n      </div>\r\n\r\n      <!-- 充值金额选择 -->\r\n      <div class=\"rate-list\">\r\n        <div\r\n            v-for=\"rate in rates\"\r\n            :key=\"rate.id\"\r\n            class=\"rate-item\"\r\n            :class=\"{ active: selectedRate?.id === rate.id }\"\r\n            @click=\"selectRate(rate)\"\r\n        >\r\n          <div class=\"amount\">￥{{ rate.amount.toFixed(2) }}</div>\r\n          <div class=\"points\">+ {{ rate.points }} 积分</div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 充值按钮 -->\r\n      <el-button\r\n          type=\"primary\"\r\n          class=\"recharge-btn\"\r\n          :disabled=\"!selectedRate\"\r\n          @click=\"handleRecharge\"\r\n      >\r\n        立即充值\r\n      </el-button>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport dayjs from 'dayjs'\r\n\r\nexport default {\r\n  name: \"Recharge\",\r\n  data() {\r\n    return {\r\n      rates: [],      // 充值比例数据\r\n      selectedRate: null, // 选中的充值项\r\n      user: {}        // 当前用户信息\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadRates()\r\n    this.loadUser()\r\n  },\r\n  methods: {\r\n    // 加载充值比例\r\n    async loadRates() {\r\n      const res = await this.$http.get('/rate')\r\n      if (res.code === '200') {\r\n        this.rates = res.data\r\n      }\r\n    },\r\n\r\n    // 加载用户信息\r\n    async loadUser() {\r\n      const user = JSON.parse(localStorage.getItem('user') || '{}')\r\n      const res = await this.$http.get(`/user/${user.id}`)\r\n      if (res.code === '200') {\r\n        this.user = res.data\r\n      }\r\n    },\r\n\r\n    // 选择充值项\r\n    selectRate(rate) {\r\n      this.selectedRate = rate\r\n    },\r\n\r\n    // 执行充值\r\n    async handleRecharge() {\r\n      try {\r\n        const res = await this.$http.post('/record/recharge', {\r\n          userId: this.user.id,\r\n          amount: this.selectedRate.amount\r\n        })\r\n\r\n        if (res.code === '200') {\r\n          this.$message.success(`成功充值 ${this.selectedRate.points} 积分`)\r\n          await this.loadUser() // 刷新用户数据\r\n          this.selectedRate = null\r\n        }\r\n      } catch (error) {\r\n        this.$message.error(error.response?.data?.message || '充值失败')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.recharge-container {\r\n  max-width: 800px;\r\n  margin: 20px auto;\r\n  padding: 20px;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.current-points {\r\n  color: #409EFF;\r\n  font-weight: bold;\r\n}\r\n\r\n.rate-list {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\r\n  gap: 20px;\r\n  margin: 30px 0;\r\n}\r\n\r\n.rate-item {\r\n  border: 1px solid #ebeef5;\r\n  border-radius: 8px;\r\n  padding: 20px;\r\n  text-align: center;\r\n  cursor: pointer;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.rate-item:hover {\r\n  border-color: #409EFF;\r\n  transform: translateY(-5px);\r\n}\r\n\r\n.rate-item.active {\r\n  border-color: #409EFF;\r\n  background: #f5f7fa;\r\n}\r\n\r\n.amount {\r\n  font-size: 24px;\r\n  color: #303133;\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.points {\r\n  color: #67C23A;\r\n  font-size: 16px;\r\n}\r\n\r\n.recharge-btn {\r\n  width: 100%;\r\n  height: 50px;\r\n  font-size: 18px;\r\n}\r\n</style>"]}]}
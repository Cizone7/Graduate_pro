{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\components\\IconSwitcher.vue?vue&type=style&index=0&id=7a42a5aa&scoped=true&lang=css","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\components\\IconSwitcher.vue","mtime":1742971347748},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\css-loader\\dist\\cjs.js","mtime":1741692740692},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1741692741778},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\postcss-loader\\src\\index.js","mtime":1741692741656},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["IconSwitcher.vue"],"names":[],"mappings":";AA8MA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA","file":"IconSwitcher.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <div class=\"main-layout\">\r\n      <!-- 左侧图标列表 -->\r\n      <div class=\"icon-panel\">\r\n        <div class=\"icon-container\">\r\n          <div\r\n              v-for=\"(icon, index) in visibleIcons\"\r\n              :key=\"index\"\r\n              class=\"icon-item\"\r\n              @click=\"selectIcon(icon)\"\r\n              :class=\"{ selected: selectedIcon === icon }\"\r\n          >\r\n            <Icon :icon=\"icon\" width=\"40\" height=\"40\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 右侧预览区 -->\r\n      <div class=\"preview-panel\">\r\n        <div v-if=\"selectedIcon\" class=\"preview-container\">\r\n          <h2>图标预览</h2>\r\n          <div class=\"preview-layout\"> <!-- 新增布局容器 -->\r\n            <div class=\"preview-wrapper\">\r\n              <Icon\r\n                :icon=\"selectedIcon\"\r\n                :width=\"iconSize\"\r\n                :height=\"iconSize\"\r\n                :style=\"{\r\n                  color: iconColor,\r\n                  stroke: iconColor,\r\n                  strokeWidth: iconStrokeWidth + 'px'\r\n                }\"\r\n              />\r\n            </div>\r\n            <div class=\"control-area\">\r\n              <div class=\"controls\">\r\n                <div class=\"control-group\">\r\n                  <label>颜色设置</label>\r\n                  <input type=\"color\" v-model=\"iconColor\" />\r\n                </div>\r\n\r\n                <div class=\"control-group\">\r\n                  <label>尺寸设置 {{ iconSize }}px</label>\r\n                  <input\r\n                      type=\"range\"\r\n                      min=\"20\"\r\n                      max=\"100\"\r\n                      v-model=\"iconSize\"\r\n                  />\r\n                </div>\r\n\r\n                <div class=\"control-group\">\r\n                  <label>线条粗细 {{ iconStrokeWidth }}px</label>\r\n                  <input\r\n                      type=\"range\"\r\n                      min=\"1\"\r\n                      max=\"10\"\r\n                      v-model=\"iconStrokeWidth\"\r\n                  />\r\n                </div>\r\n              </div>\r\n              <div class=\"action-buttons\">\r\n                <button @click=\"copySvgCode\">复制SVG代码</button>\r\n                <button @click=\"downloadPng\">下载PNG</button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Icon } from '@iconify/vue2'; // 引入 Iconify Vue2 组件\r\nimport { Canvg } from 'canvg';\r\nimport { getIcon } from '@iconify/iconify';\r\n\r\nexport default {\r\n  components: {\r\n    Icon,\r\n  },\r\n  data() {\r\n    return {\r\n      iconLibrary: 'line-md',\r\n      iconNames: [\r\n          'account', 'account-add', 'account-alert', 'account-alert-loop', 'account-delete','account-remove','alert','alert-circle',\r\n          'align-center','align-justify','align-left','align-right', 'arrow-align-center','arrow-align-bottom','arrow-align-left',\r\n          'arrow-align-right','at','backup-restore','beer', 'bell','brake','brake-abs','brake-alert',\r\n          'briefcase','briefcase-cancel','briefcase-check','briefcase-minus', 'briefcase-plus','buy-me-a-coffee','buy-me-a-coffee-filled','cake',\r\n          'calendar','cancel','car-light','cellphone','chat','chat-bubble','chat-round','chat-round-dots','check-all',\r\n          'edit','email','emoji-angry','emoji-cry','emoji-frown','emoji-frown-open','emoji-grin','emoji-neutral','emoji-smile','emoji-smile-wink',\r\n          'engine','engine-off','external-link','gauge','gauge-empty',\r\n      ],\r\n      visibleIcons: [],\r\n      selectedIcon: null, // 当前选中的图标\r\n      iconColor: '#000000', // 颜色\r\n      iconSize: 50, // 图标大小\r\n      iconStrokeWidth: 2, // 线条粗细\r\n    };\r\n  },\r\n  created() {\r\n    this.loadIcons(); // 初始化加载图标\r\n    this.selectedIcon = this.visibleIcons[0]; // 默认选中第一个图标\r\n  },\r\n  methods: {\r\n    loadIcons() {\r\n      this.visibleIcons = this.iconNames.map(name => `${this.iconLibrary}:${name}`);\r\n    },\r\n    selectIcon(icon) {\r\n      this.selectedIcon = icon; // 选中图标\r\n    },\r\n    // 获取当前图标的 SVG 代码\r\n    getSvgCode() {\r\n      const iconData = getIcon(this.selectedIcon);\r\n      if (!iconData) return '';\r\n\r\n      // 使用更可靠的方式处理颜色\r\n      const body = iconData.body\r\n          .replace(/<animate[^>]*>/g, '')\r\n          .replace(/stroke-dasharray=\"[^\"]*\"/g, '')\r\n          .replace(/stroke-dashoffset=\"[^\"]*\"/g, '')\r\n          // 使用更全面的正则表达式替换\r\n          .replace(/(<path[^>]*)(fill|stroke)=\"[^\"]*\"/gi, (match, p1, p2) => {\r\n            return `${p1}${p2}=\"${this.iconColor}\"`;\r\n          })\r\n          .replace(/(<path[^>]*)stroke-width=\"[^\"]*\"/gi, (match, p1) => {\r\n            return `${p1}stroke-width=\"${this.iconStrokeWidth}\"`;\r\n          });\r\n\r\n      return `<svg xmlns=\"http://www.w3.org/2000/svg\"\r\n              viewBox=\"0 0 ${iconData.width} ${iconData.height}\"\r\n              width=\"${this.iconSize}\"\r\n              height=\"${this.iconSize}\"\r\n              style=\"color:${this.iconColor}\">\r\n    <g transform=\"translate(0.5,0.5)\"\r\n       fill=\"${this.iconColor}\"\r\n       stroke=\"${this.iconColor}\"\r\n       stroke-width=\"${this.iconStrokeWidth}\">\r\n      ${body}\r\n    </g>\r\n  </svg>`;\r\n    },\r\n    // 复制SVG代码到剪贴板\r\n    copySvgCode() {\r\n      const svgCode = this.getSvgCode();\r\n      navigator.clipboard.writeText(svgCode).then(() => {\r\n        alert('SVG代码已复制');\r\n      });\r\n    },\r\n    // 下载PNG\r\n    async downloadPng() {\r\n      try {\r\n        const svgCode = this.getSvgCode(); // 获取最新的 SVG 代码\r\n\r\n        // 创建离屏canvas\r\n        const canvas = document.createElement('canvas');\r\n        const ctx = canvas.getContext('2d');\r\n        // 设置canvas尺寸（不进行缩放，使用原始图标尺寸）\r\n        const scale = 1;\r\n        canvas.width = this.iconSize * scale;\r\n        canvas.height = this.iconSize * scale;\r\n\r\n        ctx.fillStyle = '#ffffff';\r\n        ctx.fillRect(0, 0, canvas.width, canvas.height);\r\n\r\n        // 创建Canvg实例\r\n        const v = await Canvg.from(ctx, svgCode, {\r\n          ignoreAnimation: true,\r\n          ignoreMouse: true,\r\n          ignoreDimensions: true,\r\n          scale,\r\n          useCSSStyles: true // 强制使用CSS样式\r\n        });\r\n\r\n        await v.render({\r\n          enableRedraw: true,\r\n          ignoreClear: true\r\n        });\r\n\r\n        // 将canvas转为PNG\r\n        const blob = await new Promise(resolve => {\r\n          canvas.toBlob(resolve, 'image/png', 1);\r\n        });\r\n\r\n        // 创建下载链接\r\n        const link = document.createElement('a');\r\n        link.href = URL.createObjectURL(blob);\r\n        link.download = `icon_${Date.now()}.png`;\r\n        link.style.display = 'none';\r\n        document.body.appendChild(link);\r\n        link.click();\r\n        document.body.removeChild(link);\r\n        setTimeout(() => URL.revokeObjectURL(link.href), 100);\r\n\r\n      } catch (error) {\r\n        console.error('下载失败:', error);\r\n        alert(`下载错误: ${error.message}`);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.container {\r\n  max-width: 1400px;\r\n  margin: 0 auto; /* 水平居中 */\r\n  padding: 40px 20px 20px 20px; /* 增加顶部的 padding */\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n  color: #2c3e50;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  gap: 30px;\r\n  justify-content: center; /* 水平居中 */\r\n  align-items: flex-start; /* 保持顶部对齐 */\r\n  height: calc(100vh - 160px);\r\n  margin-top: 20px; /* 向下偏移 */\r\n}\r\n\r\n/* 左侧图标面板 */\r\n.icon-panel {\r\n  width: 400px;\r\n  background: #f8f9fa;\r\n  border-radius: 12px;\r\n  padding: 20px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  height: auto;\r\n  max-height: 500px;\r\n}\r\n\r\n.icon-container {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));\r\n  gap: 15px;\r\n  max-height: 400px;\r\n  overflow-y: auto;\r\n  padding: 10px;\r\n}\r\n\r\n.icon-item {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  width: 60px;\r\n  height: 60px;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n  background: white;\r\n}\r\n\r\n.icon-item:hover {\r\n  transform: scale(1.05);\r\n  box-shadow: 0 2px 6px rgba(0,0,0,0.1);\r\n}\r\n\r\n.icon-item.selected {\r\n  background: #e3f2fd;\r\n  border: 2px solid #2196f3;\r\n}\r\n\r\n/* 右侧预览面板 */\r\n.preview-panel {\r\n  flex: 0 0 600px;\r\n  background: white;\r\n  border-radius: 12px;\r\n  padding: 20px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  height: auto;\r\n  max-height: 500px;\r\n}\r\n\r\n.preview-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: auto; /* 根据内容自适应高度 */\r\n  max-height: 450px; /* 设置最大高度，避免过高 */\r\n}\r\n\r\n.preview-wrapper {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 300px;\r\n  border: 2px dashed #eee;\r\n  border-radius: 12px;\r\n  margin: 20px 0;\r\n}\r\n\r\n.controls {\r\n  display: flex; /* 改为flex布局 */\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.control-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.control-group label {\r\n  font-size: 14px;\r\n  color: #666;\r\n}\r\n\r\ninput[type=\"color\"] {\r\n  width: 100%;\r\n  height: 40px;\r\n  padding: 2px;\r\n  border-radius: 6px;\r\n  border: 2px solid #ddd;\r\n}\r\n\r\ninput[type=\"range\"] {\r\n  width: 100%;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex; /* 使用flex布局 */\r\n  gap: 20px; /* 控制按钮之间的间距 */\r\n  justify-content: flex-start; /* 左对齐按钮 */\r\n  margin-top: auto; /* 推到容器底部 */\r\n}\r\n\r\nbutton {\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 6px;\r\n  background: #2196f3;\r\n  color: white;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\nbutton:hover {\r\n  background: #1976d2;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.placeholder {\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #999;\r\n  font-size: 18px;\r\n}\r\n\r\n/* 新增样式 */\r\n.preview-layout {\r\n  display: flex;\r\n  gap: 30px;\r\n  height: auto; /* 自动适应高度 */\r\n}\r\n\r\n.preview-wrapper {\r\n  width: 200px; /* 固定预览区宽度 */\r\n  min-height: 200px;\r\n  flex-shrink: 0; /* 禁止缩小 */\r\n}\r\n\r\n.control-area {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n}\r\n</style>\r\n"]}]}
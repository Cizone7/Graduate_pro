n    return {\r\n      collections: {},  // 用于存储图标库的详细信息\r\n      icons: [],         // 用于存储当前选中图标库的图标名称\r\n      error: ''          // 错误信息\r\n    };\r\n  },\r\n  async created() {\r\n    try {\r\n      // 获取所有图标库\r\n      const response = await axios.get('http://localhost:3000/collections');\r\n      console.log('图标库列表:', response.data); // 输出图标库列表以确认是否获取成功\r\n      this.collections = response.data;\r\n    } catch (err) {\r\n      console.error('获取图标库列表失败:', err);\r\n      this.error = '获取图标库列表失败: ' + (err.message || '未知错误');\r\n    }\r\n  },\r\n  methods: {\r\n    async fetchIcons(collectionName) {\r\n      try {\r\n        console.log('正在获取图标库:', collectionName);  // 输出正在请求的图标库名称\r\n        // 请求图标库中的图标（获取uncategorized数组）\r\n        const response = await axios.get(`http://localhost:3000/collection?prefix=${collectionName}`);\r\n        console.log('获取图标库的图标数据:', response.data);  // 输出返回的图标数据\r\n\r\n        // 获取图标库中的所有图标名\r\n        const uncategorizedIcons = response.data.uncategorized;\r\n\r\n        // 更新图标列表\r\n        this.icons = uncategorizedIcons || [];  // 确保是数组\r\n        console.log('更新后的图标列表:', this.icons);  // 输出更新后的图标列表\r\n      } catch (err) {\r\n        console.error(`获取图标库 ${collectionName} 中的图标失败:`, err);\r\n        this.error = `获取图标库 ${collectionName} 中的图标失败: ${err.message || '未知错误'}`;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.icon {\r\n  margin: 5px;\r\n  padding: 5px;\r\n  border: 1px solid #ddd;\r\n  display: inline-block;\r\n}\r\n\r\n.error {\r\n  color: red;\r\n  font-weight: bold;\r\n}\r\n</style>\r\n"]}]}
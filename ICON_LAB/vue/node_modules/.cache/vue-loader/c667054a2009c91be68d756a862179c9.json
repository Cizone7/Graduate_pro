\r\n                    :on-success=\"handleSuccess\"\r\n                    drag\r\n                    :show-file-list=\"false\"\r\n                >\r\n                  <div class=\"upload-content\">\r\n                    <i class=\"el-icon-upload\"></i>\r\n                    <div class=\"upload-text\">\r\n                      将图片拖到此处，或<em>点击上传</em>\r\n                    </div>\r\n                    <div class=\"upload-tips\">支持JPG/PNG格式，大小不超过5MB</div>\r\n                  </div>\r\n                </el-upload>\r\n              </div>\r\n\r\n              <!-- 图片列表 -->\r\n              <div class=\"image-list\">\r\n                <div\r\n                    v-for=\"(file, index) in fileList\"\r\n                    :key=\"index\"\r\n                    class=\"image-item\"\r\n                    :class=\"{ active: selectedImage?.url === file.url }\"\r\n                    @click=\"selectImage(file)\"\r\n                    @mouseenter=\"hoverIndex = index\"\r\n                    @mouseleave=\"hoverIndex = -1\"\r\n                >\r\n                  <img :src=\"file.url\" class=\"image-preview\" />\r\n                  <transition name=\"el-fade-in\">\r\n                    <div v-show=\"hoverIndex === index\" class=\"operation-layer\">\r\n                      <el-button\r\n                          type=\"danger\"\r\n                          icon=\"el-icon-delete\"\r\n                          circle\r\n                          class=\"delete-btn\"\r\n                          @click.stop=\"handleRemove(file)\"\r\n                      ></el-button>\r\n                    </div>\r\n                  </transition>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 右侧编辑面板 -->\r\n            <div class=\"right-panel\" v-if=\"selectedImage\">\r\n              <el-card class=\"edit-card\">\r\n                <div class=\"selected-preview\">\r\n                  <img :src=\"selectedImage.url\" class=\"selected-image\" />\r\n                </div>\r\n\r\n                <el-form\r\n                    label-width=\"100px\"\r\n                    size=\"medium\"\r\n                    :model=\"form\"\r\n                    :rules=\"rules\"\r\n                    ref=\"ruleForm\"\r\n                >\r\n                  <el-form-item label=\"作品标题\" prop=\"name\">\r\n                    <el-input\r\n                        v-model=\"form.name\"\r\n                        placeholder=\"请输入作品名称\"\r\n                        clearable\r\n                    ></el-input>\r\n                  </el-form-item>\r\n\r\n                  <el-form-item label=\"作品积分\" prop=\"count\">\r\n                    <el-input-number\r\n                        v-model=\"form.count\"\r\n                        :min=\"1\"\r\n                        :max=\"100\"\r\n                        label=\"积分值\"\r\n                    ></el-input-number>\r\n                  </el-form-item>\r\n\r\n                  <el-form-item label=\"作品分类\" prop=\"typeId\">\r\n                    <el-select\r\n                        v-model=\"form.typeId\"\r\n                        placeholder=\"请选择分类\"\r\n                        clearable\r\n                    >\r\n                      <el-option\r\n                          v-for=\"item in types\"\r\n                          :key=\"item.id\"\r\n                          :label=\"item.name\"\r\n                          :value=\"item.id\"\r\n                      ></el-option>\r\n                    </el-select>\r\n                  </el-form-item>\r\n\r\n                  <el-form-item label=\"创作类型\" prop=\"style\">\r\n                    <el-radio-group v-model=\"form.style\">\r\n                      <el-radio label=\"原创\"></el-radio>\r\n                      <el-radio label=\"临摹\"></el-radio>\r\n                      <el-radio label=\"AI辅助\"></el-radio>\r\n                    </el-radio-group>\r\n                  </el-form-item>\r\n\r\n                  <el-form-item>\r\n                    <el-button\r\n                        type=\"primary\"\r\n                        @click=\"submitForm\"\r\n                        style=\"width: 100%\"\r\n                    >\r\n                      提交作品\r\n                    </el-button>\r\n                  </el-form-item>\r\n                </el-form>\r\n              </el-card>\r\n            </div>\r\n          </div>\r\n        </el-card>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<style scoped>\r\n.image-item {\r\n  position: relative;\r\n  border-radius: 6px;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n  transition: all 0.3s;\r\n  aspect-ratio: 1;\r\n  border: 2px solid transparent;\r\n}\r\n\r\n.image-item.active {\r\n  border-color: #409eff;\r\n  transform: translateY(-3px);\r\n  box-shadow: 0 4px 12px rgba(64, 158, 255, 0.2);\r\n}\r\n\r\n.operation-layer {\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 0;\r\n  right: 0;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 5px 0;\r\n  transition: background 0.3s;\r\n}\r\n\r\n.operation-layer .delete-btn {\r\n  width: 32px;\r\n  height: 32px;\r\n  font-size: 16px;\r\n  padding: 0;\r\n}\r\n\r\n.operation-layer:hover {\r\n  background: rgba(0, 0, 0, 0.7);\r\n}\r\n</style>\r\n"]}]}
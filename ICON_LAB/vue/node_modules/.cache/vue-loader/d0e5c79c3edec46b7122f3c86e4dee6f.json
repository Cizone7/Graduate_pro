{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\Home.vue?vue&type=style&index=0&id=5826cf82&scoped=true&lang=css","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\Home.vue","mtime":1742930017870},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\css-loader\\dist\\cjs.js","mtime":1741692740692},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1741692741778},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\postcss-loader\\src\\index.js","mtime":1741692741656},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Home.vue"],"names":[],"mappings":";AA+KA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"Home.vue","sourceRoot":"src/views/front","sourcesContent":["<template>\n  <div class=\"home-container\">\n    <!-- 轮播图部分保持不变 -->\n    <div style=\"margin: 10px 0\">\n      <el-carousel height=\"300px\" :interval=\"10000\">\n        <el-carousel-item v-for=\"item in imgs\" :key=\"item\">\n          <img :src=\"item\" style=\"width: 100%;height: 100%\">\n        </el-carousel-item>\n      </el-carousel>\n    </div>\n\n    <!-- 热门作者榜 -->\n    <div style=\"font-size: 32px; margin: 15px 0; display: inline-block\">\n      <span style=\"color: #1abc9c\">热门作者榜</span>\n    </div>\n    <div>\n      <el-row :gutter=\"10\">\n        <el-col\n            :span=\"4\"\n            v-for=\"item in rank\"\n            :key=\"item.id\"\n            style=\"margin-bottom: 10px\"\n        >\n          <div class=\"author-card\" @click=\"$router.push(`/front/personal?id=${item.id}`)\">\n            <img\n                :src=\"item.avatarUrl || require('@/assets/default-avatar.png')\"\n                class=\"author-avatar\"\n            >\n            <div class=\"author-name\">\n              <i class=\"el-icon-user\"></i> {{ item.nickname }}\n            </div>\n          </div>\n        </el-col>\n      </el-row>\n    </div>\n\n    <!-- 搜索框 -->\n    <el-card style=\"margin-top: 10px;\">\n      <div class=\"search-container\">\n        <el-input\n            v-model=\"searchKeyword\"\n            placeholder=\"搜索作品/图库\"\n            @keyup.enter=\"handleSearch\"\n            clearable\n        >\n          <el-button\n              slot=\"append\"\n              icon=\"el-icon-search\"\n              @click=\"handleSearch\"\n          ></el-button>\n        </el-input>\n      </div>\n    </el-card>\n\n    <!-- 瀑布流展示 -->\n    <div style=\"margin-top: 20px\">\n      <waterfall :col=\"7\" :width=\"150\" :data=\"items\">\n        <div\n            class=\"cell-item\"\n            v-for=\"(item, index) in items\"\n            :key=\"index\"\n            @click=\"$router.push(`/front/detail?id=${item.id}`)\"\n        >\n          <img\n              :src=\"item.img\"\n              class=\"creation-image\"\n              alt=\"作品预览\"\n              @error=\"handleImageError\"\n          >\n          <div class=\"item-body\">\n            <div class=\"item-desc\">\n              <span>{{ item.name }}</span>\n              <el-tag :type=\"getTagType(item.style)\">{{ item.style }}</el-tag>\n            </div>\n            <div class=\"item-footer\">\n              <div class=\"author-info\">\n                <img\n                    :src=\"getUserAvatar(item.userId)\"\n                    class=\"user-avatar\"\n                >\n                <span class=\"user-name\">{{ getUserNickname(item.userId) }}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </waterfall>\n\n      <!-- 无数据提示 -->\n      <div v-if=\"items.length === 0\" class=\"empty-tip\">\n        <el-empty description=\"暂无作品\"></el-empty>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"Home\",\n  data() {\n    return {\n      searchKeyword: '',\n      items: [],\n      users: [], // 用户数据缓存\n      rank: [],  // 热门作者榜\n      imgs: [/* 轮播图地址 */]\n    }\n  },\n  created() {\n    this.loadInitialData();\n  },\n  methods: {\n    async loadInitialData() {\n      try {\n        // 加载作品数据\n        const res = await this.request.get(\"/creation/front/page\", {\n          params: { pageNum: 1, pageSize: 20 }\n        });\n        this.items = res.data?.records || [];\n\n        // 加载用户数据\n        const userRes = await this.request.get(\"/user\");\n        this.users = userRes.data || [];\n\n        // 加载热门作者\n        const rankRes = await this.request.get(\"/user/front/count\");\n        this.rank = rankRes.data?.slice(0,5) || []; // 取前5名\n      } catch (error) {\n        console.error('初始化数据加载失败:', error);\n      }\n    },\n\n    // 用户信息获取方法\n    getUserAvatar(userId) {\n      const user = this.users.find(u => u.id === userId);\n      return user?.avatarUrl || require('@/assets/default-avatar.png');\n    },\n\n    getUserNickname(userId) {\n      const user = this.users.find(u => u.id === userId);\n      return user?.nickname || '未知用户';\n    },\n\n    // 搜索处理\n    handleSearch() {\n      const keyword = this.searchKeyword.trim();\n      if (!keyword) {\n        this.$message.warning('请输入搜索内容');\n        return;\n      }\n      this.$router.push({\n        path: '/front/search',\n        query: { keyword: encodeURIComponent(keyword) }\n      });\n    },\n\n    // 图片加载失败处理\n    handleImageError(e) {\n      e.target.src = require('@/assets/default-image.png');\n    },\n\n    // 标签样式映射\n    getTagType(style) {\n      const map = {\n        '原创': 'warning',\n        '同人': 'danger',\n        '临摹': 'primary',\n        'AI辅助': 'success'\n      };\n      return map[style] || 'info';\n    }\n  }\n}\n</script>\n\n<style scoped>\n.home-container {\n  width: 75%;\n  margin: 0 auto;\n}\n\n/* 作者卡片样式 */\n.author-card {\n  border: 1px solid #ebeef5;\n  border-radius: 8px;\n  padding: 10px;\n  transition: transform 0.3s;\n  &:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 2px 12px rgba(0,0,0,0.1);\n  }\n}\n\n.author-avatar {\n  width: 60px;\n  height: 60px;\n  border-radius: 50%;\n  display: block;\n  margin: 0 auto;\n}\n\n.author-name {\n  text-align: center;\n  margin-top: 8px;\n  font-size: 14px;\n  color: #606266;\n}\n\n/* 作品卡片样式 */\n.cell-item {\n  background: #fff;\n  border-radius: 8px;\n  margin-bottom: 10px;\n  overflow: hidden;\n  box-shadow: 0 2px 12px rgba(0,0,0,0.1);\n  transition: transform 0.3s;\n  &:hover {\n    transform: translateY(-3px);\n  }\n}\n\n.creation-image {\n  width: 100%;\n  height: 200px;\n  object-fit: cover;\n  background: #f5f7fa;\n}\n\n.item-body {\n  padding: 12px;\n}\n\n.item-desc {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n\n.user-avatar {\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  margin-right: 8px;\n}\n\n.author-info {\n  display: flex;\n  align-items: center;\n  font-size: 12px;\n  color: #909399;\n}\n\n.empty-tip {\n  padding: 40px 0;\n  text-align: center;\n  color: #909399;\n}\n</style>"]}]}
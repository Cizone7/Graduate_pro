s = data.icons;\r\n    },\r\n    previewIcon(icon) {\r\n      this.previewIcon = icon;\r\n    },\r\n    getIconUrl(icon) {\r\n      return `https://api.iconify.design/${icon}.svg`;\r\n    },\r\n    async downloadIcon() {\r\n      const svgCode = await this.getIconSvg(this.previewIcon);\r\n      const tempDiv = document.createElement(\"div\");\r\n      tempDiv.innerHTML = svgCode;\r\n      document.body.appendChild(tempDiv);\r\n\r\n      const canvas = await html2canvas(tempDiv);\r\n      const link = document.createElement(\"a\");\r\n      link.href = canvas.toDataURL(\"image/png\");\r\n      link.download = `${this.previewIcon}.png`;\r\n      link.click();\r\n\r\n      document.body.removeChild(tempDiv);\r\n    },\r\n    async getIconSvg(iconName) {\r\n      const response = await fetch(\r\n          `https://api.iconify.design/${iconName}.svg`\r\n      );\r\n      return await response.text();\r\n    },\r\n  },\r\n};\r\n</script>\r\n"]}]}
/'+this.id).then(res=>{\r\n        this.items=res.data\r\n      })\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.item-center {\r\n  .el-divider--horizontal {\r\n    display: block;\r\n    height: 1px;\r\n    width: 100%;\r\n    margin: 10px 0;\r\n  }\r\n\r\n  margin-top: 20px;\r\n\r\n  .item {\r\n    height: 150px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n\r\n    .item-img {\r\n      height: 120px;\r\n      width: 180px;\r\n      flex: 1;\r\n    }\r\n\r\n\r\n    .type-container {\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: space-between;\r\n\r\n      .type-left {\r\n        flex: 1;\r\n        display: flex;\r\n        align-items: center;\r\n      }\r\n\r\n      .type-item {\r\n        flex: 1;\r\n        text-align: center;\r\n      }\r\n\r\n      .type-search {\r\n        display: flex;\r\n      }\r\n    }\r\n\r\n  }\r\n}\r\n</style>"]}]}
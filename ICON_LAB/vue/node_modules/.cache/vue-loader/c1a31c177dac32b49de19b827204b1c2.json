\nexport default {\r\n  props: ['collection'],\r\n  data() {\r\n    return {\r\n      icons: [],\r\n      iconColor: '#000000',\r\n      strokeWidth: 2,\r\n      size: 100,\r\n    }\r\n  },\r\n  async created() {\r\n    const data = await fetchIconsByCollection(this.collection)\r\n    this.icons = data.icons\r\n  },\r\n  methods: {\r\n    downloadIcon(iconName) {\r\n      const element = document.querySelector(`[icon=\"${this.collection}:${iconName}\"]`)\r\n      toPng(element).then((dataUrl) => {\r\n        const link = document.createElement('a')\r\n        link.href = dataUrl\r\n        link.download = `${iconName}.png`\r\n        link.click()\r\n      })\r\n    },\r\n  },\r\n}\r\n</script>\r\n\r\n<style>\r\n.icons-container {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n.icon-wrapper {\r\n  text-align: center;\r\n}\r\n</style>\r\n"]}]}
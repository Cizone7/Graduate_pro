{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\Submit.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\Submit.vue","mtime":1741751346181},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\babel-loader\\lib\\index.js","mtime":1741692719689},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Submit.vue"],"names":[],"mappings":";;AA8DA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Submit.vue","sourceRoot":"src/views/front","sourcesContent":["<template>\r\n  <div class=\"detail-container\">\r\n    <div class=\"main-content\">\r\n      <div class=\"title\">我要投稿</div>\r\n      <div class=\"home-container\">\r\n\r\n        <el-card style=\"margin-top: 15px\">\r\n          <el-form label-width=\"120px\" size=\"small\" style=\"width: 90%\" :model=\"form\" :rules=\"rules\" ref=\"ruleForm\">\r\n\r\n            <el-upload\r\n                class=\"img-uploader\"\r\n                action=\"http://localhost:9090/web/upload\"\r\n                :show-file-list=\"false\"\r\n                :on-success=\"handleImgUploadSuccess\"\r\n            >\r\n              <img v-if=\"form.img\" :src=\"form.img\" class=\"img\" style=\"width: 256px; height:256px\">\r\n              <i v-else class=\"el-icon-plus img-uploader-icon\"></i>\r\n            </el-upload>\r\n\r\n            <el-form-item prop=\"name\" label=\"作品标题\" >\r\n              <el-input v-model=\"form.name\" autocomplete=\"off\" placeholder=\"好的创作值得一个好名字！\"></el-input>\r\n            </el-form-item>\r\n            <el-form-item prop=\"info\" label=\"作品介绍\">\r\n              <el-input v-model=\"form.info\" autocomplete=\"off\" type=\"textarea\" placeholder=\"给创作一个简短的介绍，让更多的人理解这份创意吧！\"></el-input>\r\n            </el-form-item>\r\n            <el-form-item prop=\"typeId\" label=\"作品分类\">\r\n              <el-select v-model=\"form.typeId\" placeholder=\"请选择作品分类\">\r\n                <el-option\r\n                    v-for=\"item in types\"\r\n                    :key=\"item.id\"\r\n                    :label=\"item.name\"\r\n                    :value=\"item.id\">\r\n                </el-option>\r\n              </el-select>\r\n            </el-form-item>\r\n            <el-form-item prop=\"style\" label=\"创作类型\">\r\n              <el-radio v-model=\"form.style\" label=\"原创\">原创</el-radio>\r\n              <el-radio v-model=\"form.style\" label=\"同人\">同人</el-radio>\r\n              <el-radio v-model=\"form.style\" label=\"临摹\">临摹</el-radio>\r\n              <el-radio v-model=\"form.style\" label=\"AI辅助\">AI辅助</el-radio>\r\n            </el-form-item>\r\n\r\n\r\n          </el-form>\r\n          <div style=\"margin-top: 10px;display: flex;flex-direction:row-reverse;margin-right: 15%\">\r\n            <el-button type=\"success\" size=\"medium\" @click=\"save\">立即投稿</el-button>\r\n          </div>\r\n        </el-card>\r\n        <div style=\"height:60px;margin-bottom: 50px\"></div>\r\n\r\n      </div>\r\n\r\n    </div>\r\n    <div style=\"height:60px;margin-bottom: 50px\"></div>\r\n\r\n  </div>\r\n\r\n\r\n</template>\r\n\r\n<script>\r\n\r\nimport {serverHost} from \"../../../config/config.default\";\r\n\r\nexport default {\r\n  name: \"FrontHome\",\r\n  data() {\r\n    return {\r\n      form: {},\r\n      types:[],\r\n      serverHost : serverHost,\r\n      rules: {\r\n        name: [\r\n          { required: true, message: '请输入作品名称', trigger: 'blur'}\r\n        ],\r\n        typeId: [\r\n          { required: true, message: '请选择作品分类', trigger: 'blur'}\r\n        ],\r\n        style: [\r\n          { required: true, message: '请输入创作类型', trigger: 'blur'}\r\n        ],\r\n        info: [\r\n          { required: true, message: '请输入作品简介', trigger: 'blur'}\r\n        ],\r\n\r\n      },\r\n    };\r\n  },\r\n  created() {\r\n    this.request.get(\"/type\").then(res=>{\r\n      this.types=res.data\r\n    })\r\n  },\r\n  methods: {\r\n    save() {\r\n\r\n      this.$refs['ruleForm'].validate((valid) => {\r\n        if (valid) {\r\n          this.request.post(\"/creation\", this.form).then(res => {\r\n            if (res.code === '200') {\r\n              this.$message.success(\"投稿成功\")\r\n              this.form={}\r\n              this.load()\r\n            } else {\r\n              this.$message.error(res.msg)\r\n            }\r\n          })\r\n        }\r\n      })\r\n    },\r\n    del(id) {\r\n      this.request.delete(\"/item/\" + id).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success(\"删除成功\")\r\n          this.load()\r\n        } else {\r\n          this.$message.error(\"删除失败\")\r\n        }\r\n      })\r\n    },\r\n    handleImgUploadSuccess(res) {\r\n      this.form.img = res\r\n      this.$forceUpdate()\r\n    },\r\n  }\r\n};\r\n</script>\r\n\r\n<style lang=\"scss\" >\r\n.text {\r\n  font-size: 14px;\r\n}\r\n\r\n.detail-container {\r\n  margin: 0 auto;\r\n  display: flex;\r\n  height: 40vh;\r\n  background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0), white), linear-gradient(to right, #5293ff, #4ee0cd);\r\n  background-image: url(https://img.zcool.cn/community/01913f6111dc9211013f47205d045d.jpg);\r\n  background-size: cover;\r\n  background-repeat: no-repeat;\r\n  background-position: center center;\r\n\r\n  .main-content {\r\n    width: 70%;\r\n    margin: 0 auto;\r\n    display: flex;\r\n    margin-top: 11%;\r\n    background-color: #fff;\r\n    padding: 30px 20px;\r\n    flex-direction: column;\r\n\r\n    .title {\r\n      font-size: 25px;\r\n\r\n      &::after {\r\n        content: '';\r\n        width: 100px;\r\n        background-color: var(--color-primary);\r\n        height: 4px;\r\n        display: block;\r\n        border-radius: 10px;\r\n      }\r\n\r\n      .info {\r\n        background-color: #eee;\r\n        font-size: 16px;\r\n        margin-bottom: 50px;\r\n        width: 95%;\r\n        border-radius: 10px;\r\n        padding: 20px 10px;\r\n        padding-top: 25px;\r\n\r\n        .time {\r\n          margin-bottom: 10px;\r\n        }\r\n      }\r\n\r\n      .btns-wrap {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 20px;\r\n        align-items: center;\r\n\r\n        .el-button {\r\n          height: 40px;\r\n          width: 50%;\r\n          font-size: 14px;\r\n          border-radius: 50px;\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  .home-container {\r\n    width: 90%;\r\n    margin: 0 auto;\r\n\r\n\r\n  }\r\n}\r\n\r\n.item {\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.clearfix:before,\r\n.clearfix:after {\r\n  display: table;\r\n  content: \"\";\r\n}\r\n\r\n.clearfix:after {\r\n  clear: both\r\n}\r\n\r\n.img-uploader {\r\n  text-align: center;\r\n  padding-bottom: 10px;\r\n}\r\n.img-uploader .el-upload {\r\n  border: 1px dashed #d9d9d9;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n.img-uploader .el-upload:hover {\r\n  border-color: #409EFF;\r\n}\r\n.img-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n  width: 350px;\r\n  height: 280px;\r\n  line-height: 280px;\r\n  text-align: center;\r\n}\r\n.img {\r\n  width: 350px;\r\n  height: 280px;\r\n  display: block;\r\n}\r\n\r\n\r\n\r\n</style>\r\n"]}]}
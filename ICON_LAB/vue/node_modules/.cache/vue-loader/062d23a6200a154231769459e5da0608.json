{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\test.vue?vue&type=style&index=0&id=ae9b1b5c&scoped=true&lang=css","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\test.vue","mtime":1743577472923},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\css-loader\\dist\\cjs.js","mtime":1741692740692},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1741692741778},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\postcss-loader\\src\\index.js","mtime":1741692741656},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["test.vue"],"names":[],"mappings":";AA2MA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"test.vue","sourceRoot":"src/views/front","sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <!-- 左侧图标库列表 -->\r\n    <div class=\"sidebar\">\r\n      <h2>图标库列表</h2>\r\n      <ul>\r\n        <li\r\n            v-for=\"collection in collections\"\r\n            :key=\"collection.prefix\"\r\n            @click=\"loadIcons(collection.prefix)\"\r\n        >\r\n          {{ collection.name }} ({{ collection.total }})\r\n        </li>\r\n      </ul>\r\n    </div>\r\n\r\n    <!-- 右侧图标展示区 -->\r\n    <div class=\"content\" @scroll=\"handleScroll\">\r\n      <div v-if=\"currentCollection\" class=\"collection-info\">\r\n        <h2>{{ currentCollection.name }}</h2>\r\n        <p>前缀: {{ currentCollection.prefix }}</p>\r\n        <p>总数: {{ currentCollection.total }}</p>\r\n      </div>\r\n\r\n      <div v-if=\"icons.length\" class=\"icons-grid\">\r\n        <div\r\n            v-for=\"(icon, index) in icons\"\r\n            :key=\"`${icon}-${index}`\"\r\n            class=\"icon-item\"\r\n            @click=\"copyIconName(icon)\"\r\n        >\r\n          <img\r\n              v-if=\"currentCollection && currentCollection.prefix\"\r\n              :data-src=\"iconUrl(icon)\"\r\n              :alt=\"icon\"\r\n              class=\"icon-image lazy\"\r\n              @load=\"handleImageLoad\"\r\n              @error=\"handleImageError\"\r\n          />\r\n          <div class=\"icon-name\">{{ icon }}</div>\r\n        </div>\r\n      </div>\r\n      <div v-if=\"loadingMore\" class=\"loading-more\">\r\n        加载更多...\r\n      </div>\r\n      <div v-else class=\"no-icons\">\r\n        {{ iconsLoaded ? '该图标库暂无数据' : '正在加载中...' }}\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      collections: [],\r\n      icons: [],\r\n      currentCollection: null,\r\n      iconsLoaded: false,\r\n      allIcons: [],       // 存储所有图标\r\n      currentPage: 1,     // 当前页码\r\n      pageSize: 60,      // 每页数量\r\n      loadingMore: false, // 加载状态\r\n      observer: null      // IntersectionObserver实例\r\n    };\r\n  },\r\n\r\n  computed: {\r\n    // 修复后的分页计算属性\r\n    paginatedIcons() {\r\n      return this.allIcons?.slice(0, this.currentPage * this.pageSize) || [];\r\n    }\r\n  },\r\n\r\n  async mounted() {\r\n    try {\r\n      const response = await fetch('http://localhost:3000/collections');\r\n      const data = await response.json();\r\n\r\n      // 转换数据结构为数组\r\n      this.collections = Object.keys(data).map(prefix => ({\r\n        prefix,\r\n        ...data[prefix]\r\n      }));\r\n\r\n      // 默认加载第一个图标库\r\n      if (this.collections.length > 0) {\r\n        this.loadIcons(this.collections[0].prefix);\r\n      }\r\n    } catch (error) {\r\n      console.error('加载图标库失败:', error);\r\n    }\r\n  },\r\n\r\n  methods: {\r\n    async loadIcons(prefix) {\r\n      this.iconsLoaded = false;\r\n      try {\r\n        const response = await fetch(\r\n            `http://localhost:3000/collection?prefix=${prefix}`\r\n        );\r\n        const data = await response.json();\r\n\r\n        console.log('API Response:', data);\r\n        const hidden = data.hidden || [];\r\n\r\n        // 更新当前选中的图标库信息\r\n        this.currentCollection = this.collections.find(c => c.prefix === prefix) || null;\r\n\r\n        const categories = data.categories ? Object.values(data.categories).flat() : [];\r\n        const uncategorized = data.uncategorized || [];\r\n\r\n        // 合并并过滤图标\r\n        this.allIcons =[...categories, ...uncategorized].filter(icon => !hidden.includes(icon));\r\n\r\n        // 初始化分页\r\n        this.currentPage = 1;\r\n        this.icons = this.paginatedIcons;\r\n        this.iconsLoaded = true;\r\n\r\n        // 初始化懒加载\r\n        this.$nextTick(() => {\r\n          this.initLazyLoad();\r\n        });\r\n      } catch (error) {\r\n        console.error('加载失败:', error);\r\n        this.iconsLoaded = true;\r\n      }\r\n    },\r\n\r\n    // 滚动处理\r\n    handleScroll(event) {\r\n      const { scrollTop, scrollHeight, clientHeight } = event.target;\r\n      const bottomOffset = 100;\r\n\r\n      if (scrollHeight - (scrollTop + clientHeight) < bottomOffset) {\r\n        this.loadMore();\r\n      }\r\n    },\r\n\r\n    // 加载更多\r\n    loadMore() {\r\n      if (this.loadingMore || this.icons.length >= this.allIcons.length) return;\r\n\r\n      this.loadingMore = true;\r\n      setTimeout(() => {\r\n        this.currentPage++;\r\n        this.icons = this.paginatedIcons;\r\n        this.loadingMore = false;\r\n        this.initLazyLoad();\r\n      }, 500);\r\n    },\r\n\r\n    // 初始化图片懒加载\r\n    initLazyLoad() {\r\n      if (this.observer) this.observer.disconnect();\r\n\r\n      this.observer = new IntersectionObserver((entries) => {\r\n        entries.forEach(entry => {\r\n          if (entry.isIntersecting) {\r\n            const img = entry.target;\r\n            img.src = img.dataset.src;\r\n            this.observer.unobserve(img);\r\n          }\r\n        });\r\n      }, { rootMargin: '100px 0px' });\r\n\r\n      document.querySelectorAll('.lazy').forEach(img => {\r\n        this.observer.observe(img);\r\n      });\r\n    },\r\n\r\n    // 生成正确的图标URL\r\n    iconUrl(iconName) {\r\n      if (!this.currentCollection || !this.currentCollection.prefix) {\r\n        return '';  // 避免 undefined 导致错误请求\r\n      }\r\n      return `http://localhost:3000/${this.currentCollection.prefix}/${iconName}.svg`;\r\n    },\r\n\r\n    // 图片加载成功处理\r\n    handleImageLoad(event) {\r\n      event.target.style.opacity = 1;\r\n    },\r\n\r\n    // 图片加载失败处理\r\n    handleImageError(event) {\r\n      console.error('图片加载失败:', event.target.src);\r\n      event.target.style.display = 'none';\r\n    },\r\n\r\n    // 复制图标名称\r\n    copyIconName(iconName) {\r\n      const fullName = `${this.currentCollection?.prefix}:${iconName}`;\r\n      navigator.clipboard.writeText(fullName);\r\n      alert(`已复制: ${fullName}`);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.lazy {\r\n  opacity: 0;\r\n  transition: opacity 0.3s;\r\n}\r\n\r\n.loading-more {\r\n  text-align: center;\r\n  padding: 20px;\r\n  color: #666;\r\n  font-size: 14px;\r\n}\r\n\r\n.icon-image {\r\n  background: #f5f5f5;\r\n  border-radius: 4px;\r\n  width: 48px;\r\n  height: 48px;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.no-icons {\r\n  text-align: center;\r\n  padding: 20px;\r\n  color: #666;\r\n}\r\n\r\n.container {\r\n  display: flex;\r\n  height: 100vh;\r\n}\r\n\r\n.sidebar {\r\n  width: 300px;\r\n  padding: 20px;\r\n  border-right: 1px solid #ccc;\r\n  overflow-y: auto;\r\n}\r\n\r\n.sidebar ul {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.sidebar li {\r\n  padding: 10px;\r\n  cursor: pointer;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n.sidebar li:hover {\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.icons-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\r\n  gap: 16px;\r\n  padding: 16px;\r\n}\r\n\r\n.icon-item {\r\n  border: 1px solid #eee;\r\n  border-radius: 8px;\r\n  padding: 12px;\r\n  text-align: center;\r\n  transition: transform 0.2s;\r\n  cursor: pointer;\r\n}\r\n\r\n.icon-item:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n}\r\n\r\n.icon-name {\r\n  font-size: 12px;\r\n  word-break: break-word;\r\n  color: #666;\r\n}\r\n\r\n.collection-info {\r\n  margin-bottom: 20px;\r\n  padding-bottom: 20px;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n</style>"]}]}
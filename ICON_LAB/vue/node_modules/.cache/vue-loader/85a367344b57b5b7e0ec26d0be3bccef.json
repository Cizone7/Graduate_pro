150\" :data=\"items\">\r\n      <div\r\n          class=\"cell-item\"\r\n          v-for=\"(item, index) in items\"\r\n          :key=\"index\"\r\n          @click=\"$router.push(`/front/detail?id=${item.id}`)\"\r\n      >\r\n        <!-- 保持原有作品展示结构 -->\r\n        <img :src=\"item.img\" alt=\"作品图片\">\r\n        <div class=\"item-body\">\r\n          <div class=\"item-desc\">\r\n            <span>{{ item.name }}</span>\r\n            <!-- 标签显示 -->\r\n          </div>\r\n          <!-- 作者信息 -->\r\n        </div>\r\n      </div>\r\n    </waterfall>\r\n\r\n    <!-- 无结果提示 -->\r\n    <div v-if=\"items.length === 0\" class=\"empty-tip\">\r\n      未找到相关作品\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      searchKeyword: '',\r\n      items: []\r\n    }\r\n  },\r\n  created() {\r\n    // 从路由参数获取初始关键词\r\n    this.searchKeyword = this.$route.query.keyword || ''\r\n    this.loadResults()\r\n  },\r\n  methods: {\r\n    handleSearch() {\r\n      if (!this.searchKeyword.trim()) return\r\n      this.$router.replace({\r\n        query: { keyword: this.searchKeyword.trim() }\r\n      })\r\n      this.loadResults()\r\n    },\r\n    async loadResults() {\r\n      try {\r\n        const params = {\r\n          pageNum: 1,\r\n          pageSize: 20,\r\n          name: this.searchKeyword.trim()\r\n        };\r\n\r\n        // 显式移除空参数\r\n        if (!params.name) delete params.name;\r\n\r\n        const res = await this.request.get(\"/creation/front/page\", { params });\r\n        // ...处理结果...\r\n      } catch (error) {\r\n        console.error('搜索失败:', error);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.search-container {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px;\r\n}\r\n\r\n.empty-tip {\r\n  text-align: center;\r\n  padding: 50px 0;\r\n  color: #666;\r\n}\r\n</style>"]}]}
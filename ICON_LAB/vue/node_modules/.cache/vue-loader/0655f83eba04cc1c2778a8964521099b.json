{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\Creation.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\Creation.vue","mtime":1743958460272},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\babel-loader\\lib\\index.js","mtime":1741692719689},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Creation.vue"],"names":[],"mappings":";;AA+FA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Creation.vue","sourceRoot":"src/views","sourcesContent":["<template>\n  <div>\n    <div style=\"\">\n      <el-input style=\"width: 200px\" placeholder=\"请输入作品名称\" suffix-icon=\"el-icon-search\" v-model=\"name\"></el-input>\n      <el-button class=\"ml-5\" plain type=\"primary\" @click=\"load\">搜索</el-button>\n      <el-button type=\"info\" plain @click=\"reset\">重置</el-button>\n    </div>\n\n    <div style=\"margin: 10px 0\">\n<!--      <el-button type=\"primary\" plain @click=\"handleAdd\">新增 <i class=\"el-icon-circle-plus-outline\"></i></el-button>-->\n      <el-popconfirm\n          class=\"ml-5\"\n          confirm-button-text='确定'\n          cancel-button-text='我再想想'\n          icon=\"el-icon-info\"\n          icon-color=\"red\"\n          title=\"您确定批量删除这些数据吗？\"\n          @confirm=\"delBatch\"\n      >\n        <el-button type=\"danger\" plain slot=\"reference\">批量删除 <i class=\"el-icon-remove-outline\"></i></el-button>\n      </el-popconfirm>\n    </div>\n\n    <el-card>\n      <el-table :data=\"tableData\" stripe @selection-change=\"handleSelectionChange\" :header-cell-style=\"{'padding-left':'4px','padding-right':'4px'}\">\n        <el-table-column type=\"selection\" width=\"60\"></el-table-column>\n        <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\n        <el-table-column prop=\"name\" label=\"作品标题\"></el-table-column>\n        <el-table-column label=\"作品分类\">\n          <template v-slot=\"scope\">\n            <span v-if=\"scope.row.typeId\">{{ types.find(v => v.id === scope.row.typeId) ? types.find(v => v.id === scope.row.typeId).name : ''  }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"style\" label=\"创作类型\"></el-table-column>\n        <el-table-column label=\"上传用户\">\n          <template v-slot=\"scope\">\n            <span v-if=\"scope.row.userId\">{{ users.find(v => v.id === scope.row.userId) ? users.find(v => v.id === scope.row.userId).nickname : ''  }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"time\" label=\"上传时间\"></el-table-column>\n        <el-table-column label=\"作品文件\">\n          <template v-slot=\"scope\">\n            <el-image style=\"width: 120px; height: 120px;\"  :src=\"scope.row.img\" :preview-src-list=\"[scope.row.img]\"></el-image>\n          </template>\n        </el-table-column>\n         <el-table-column label=\"操作\"  width=\"200\" align=\"center\">\n          <template v-slot:=\"scope\">\n            <div class=\"table-row-options-warp\">\n<!--              <span @click=\"handleEdit(scope.row)\">编辑 </span>-->\n              <el-popconfirm\n                  class=\"ml-5\"\n                  confirm-button-text='确定'\n                  cancel-button-text='取消'\n                  icon=\"el-icon-info\"\n                  icon-color=\"red\"\n                  title=\"您确定删除这条数据吗？\"\n                  @confirm=\"del(scope.row.id)\"\n              >\n                <span slot=\"reference\">删除</span>\n              </el-popconfirm>\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div style=\"padding: 10px 0\">\n        <el-pagination\n            @size-change=\"handleSizeChange\"\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[2, 5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, sizes, prev, pager, next, jumper\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n\n    </el-card>\n\n    <el-dialog title=\"分类\" :visible.sync=\"dialogFormVisible\" width=\"30%\" >\n      <el-form label-width=\"80px\" size=\"small\">\n        <el-form-item label=\"分类名\">\n          <el-input v-model=\"form.name\" autocomplete=\"off\"></el-input>\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogFormVisible = false\">取 消</el-button>\n        <el-button type=\"primary\" @click=\"save\">确 定</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\n\nimport {serverHost} from '../../config/config.default'\n\nexport default {\n  name: \"Creation\",\n  data() {\n    return {\n      serverHost : serverHost,\n      tableData: [],\n      total: 0,\n      pageNum: 1,\n      pageSize: 10,\n      name: \"\",\n\n      form: {},\n      dialogFormVisible: false,\n      multipleSelection: [],\n      types:[],\n      users:[],\n    }\n  },\n  created() {\n    this.load()\n    this.request.get('/type').then(res=>{\n      this.types = res.data\n    })\n    this.request.get('/user').then(res=>{\n      this.users = res.data\n    })\n  },\n  methods: {\n    load() {\n      this.request.get(\"/creation/page\", {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          name: this.name,\n        }\n      }).then(res => {\n\n        this.tableData = res.data.records\n        this.total = res.data.total\n\n      })\n    },\n    save() {\n      this.request.post(\"/creation\", this.form).then(res => {\n        if (res.code === '200') {\n          this.$message.success(\"保存成功\")\n          this.dialogFormVisible = false\n          this.load()\n        } else {\n          this.$message.error(\"保存失败\")\n        }\n      })\n    },\n    handleAdd() {\n      this.dialogFormVisible = true\n      this.form = {}\n    },\n    handleEdit(row) {\n      this.form = JSON.parse(JSON.stringify(row))\n      this.dialogFormVisible = true\n    },\n    del(id) {\n      this.request.delete(\"/creation/\" + id).then(res => {\n        if (res.code === '200') {\n          this.$message.success(\"删除成功\")\n          this.load()\n        } else {\n          this.$message.error(\"删除失败\")\n        }\n      })\n    },\n    handleSelectionChange(val) {\n      this.multipleSelection = val\n    },\n    delBatch() {\n      let ids = this.multipleSelection.map(v => v.id)  // [{}, {}, {}] => [1,2,3]\n      this.request.post(\"/creation/del/batch\", ids).then(res => {\n        if (res.code === '200') {\n          this.$message.success(\"批量删除成功\")\n          this.load()\n        } else {\n          this.$message.error(\"批量删除失败\")\n        }\n      })\n    },\n    reset() {\n      this.role = \"\"\n      this.load()\n    },\n    handleSizeChange(pageSize) {\n      this.pageSize = pageSize\n      this.load()\n    },\n    handleCurrentChange(pageNum) {\n      this.pageNum = pageNum\n      this.load()\n    },\n    handleImgUploadSuccess(res) {\n      this.form.avatarUrl = res\n    },\n  }\n}\n</script>\n\n<style scoped>\n\n</style>\n"]}]}
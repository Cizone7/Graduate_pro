sync fetchIcon() {\r\n      try {\r\n        const [prefix, name] = this.iconName.split(\":\");\r\n        const apiUrl = `https://api.iconify.design/${prefix}/${name}.json`;\r\n\r\n        console.log(\"Fetching icon from:\", apiUrl); // 调试日志\r\n\r\n        const response = await fetch(apiUrl);\r\n\r\n        // 如果 API 返回 404，切换到备用方案\r\n        if (!response.ok) {\r\n          throw new Error(`HTTP error! Status: ${response.status}`);\r\n        }\r\n\r\n        const data = await response.json();\r\n\r\n        // 解析并显示 SVG\r\n        this.iconSvg = `<svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">${data.body}</svg>`;\r\n\r\n        // 备用方案：直接使用 Iconify CDN 提供的图标 URL\r\n        this.iconUrl = `https://api.iconify.design/${this.iconName}.svg`;\r\n      } catch (error) {\r\n        console.error(\"Error fetching icon:\", error);\r\n        this.errorMessage = \"加载图标失败，请检查图标名称或网络连接。\";\r\n\r\n        // 失败时提供备用图标（这里是一个默认本地图标路径）\r\n        this.iconUrl = \"/static/default-icon.svg\"; // 你可以换成自己的本地图标\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\nh2 {\r\n  font-size: 18px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.error {\r\n  color: red;\r\n  font-weight: bold;\r\n}\r\n</style>\r\n"]}]}
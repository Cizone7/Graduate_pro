{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\Stylize.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\front\\Stylize.vue","mtime":1741746080885},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\babel-loader\\lib\\index.js","mtime":1741692719689},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Stylize.vue"],"names":[],"mappings":";AA6DA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Stylize.vue","sourceRoot":"src/views/front","sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <h1>🎨 艺术风格迁移</h1>\r\n\r\n    <div class=\"upload-section\">\r\n      <!-- 内容图片上传 -->\r\n      <div class=\"upload-box\">\r\n        <h2>内容图片</h2>\r\n        <div class=\"preview-container\" @click=\"triggerContentInput\">\r\n          <img class=\"preview-img\" :src=\"contentPreview\" v-if=\"contentPreview\">\r\n          <div class=\"upload-label\" v-else>\r\n            <i>📷</i>\r\n            点击上传内容图片\r\n          </div>\r\n          <input\r\n              type=\"file\"\r\n              ref=\"contentInput\"\r\n              accept=\"image/*\"\r\n              @change=\"handleContentUpload\"\r\n              hidden\r\n          >\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 风格图片上传 -->\r\n      <div class=\"upload-box\">\r\n        <h2>风格图片</h2>\r\n        <div class=\"preview-container\" @click=\"triggerStyleInput\">\r\n          <img class=\"preview-img\" :src=\"stylePreview\" v-if=\"stylePreview\">\r\n          <div class=\"upload-label\" v-else>\r\n            <i>🎨</i>\r\n            点击上传风格图片\r\n          </div>\r\n          <input\r\n              type=\"file\"\r\n              ref=\"styleInput\"\r\n              accept=\"image/*\"\r\n              @change=\"handleStyleUpload\"\r\n              hidden\r\n          >\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <button @click=\"processImages\" :disabled=\"processing\">\r\n      {{ processing ? '处理中...' : '开始风格迁移' }}\r\n    </button>\r\n\r\n    <div class=\"loading\" v-if=\"processing\">🔄 正在处理中，请稍候...</div>\r\n    <div class=\"error\" v-if=\"error\">{{ error }}</div>\r\n\r\n    <!-- 结果展示 -->\r\n    <div class=\"result-section\" v-if=\"resultUrl\">\r\n      <h2>生成结果</h2>\r\n      <img class=\"result-img\" :src=\"resultUrl\">\r\n      <a class=\"download-btn\" :href=\"resultUrl\" download>下载结果</a>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      contentFile: null,\r\n      styleFile: null,\r\n      contentPreview: null,\r\n      stylePreview: null,\r\n      processing: false,\r\n      error: null,\r\n      resultUrl: null\r\n    }\r\n  },\r\n  methods: {\r\n    triggerContentInput() {\r\n      this.$refs.contentInput.click()\r\n    },\r\n    triggerStyleInput() {\r\n      this.$refs.styleInput.click()\r\n    },\r\n    handleContentUpload(e) {\r\n      const file = e.target.files[0]\r\n      if (file) {\r\n        this.contentFile = file\r\n        this.previewImage(file, 'content')\r\n      }\r\n    },\r\n    handleStyleUpload(e) {\r\n      const file = e.target.files[0]\r\n      if (file) {\r\n        this.styleFile = file\r\n        this.previewImage(file, 'style')\r\n      }\r\n    },\r\n    previewImage(file, type) {\r\n      const reader = new FileReader()\r\n      reader.onload = (e) => {\r\n        if (type === 'content') {\r\n          this.contentPreview = e.target.result\r\n        } else {\r\n          this.stylePreview = e.target.result\r\n        }\r\n      }\r\n      reader.readAsDataURL(file)\r\n    },\r\n    async processImages() {\r\n      if (!this.contentFile || !this.styleFile) {\r\n        this.error = '请先上传内容和风格图片'\r\n        return\r\n      }\r\n\r\n      this.processing = true\r\n      this.error = null\r\n      this.resultUrl = null\r\n\r\n      try {\r\n        const formData = new FormData()\r\n        formData.append('content', this.contentFile)\r\n        formData.append('style', this.styleFile)\r\n\r\n        const { data } = await this.$axios.post('/stylize', formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        })\r\n\r\n        if (data.status === 'success') {\r\n          this.resultUrl = data.output_url\r\n        } else {\r\n          throw new Error(data.error || '处理失败')\r\n        }\r\n      } catch (err) {\r\n        this.error = err.response?.data?.error || err.message\r\n      } finally {\r\n        this.processing = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 保持原有样式不变 */\r\n.container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 2rem;\r\n}\r\n\r\n.upload-section {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 2rem;\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.upload-box {\r\n  background: white;\r\n  border-radius: 12px;\r\n  padding: 2rem;\r\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\r\n  transition: transform 0.2s;\r\n}\r\n\r\n.preview-container {\r\n  position: relative;\r\n  width: 100%;\r\n  aspect-ratio: 1;\r\n  border: 2px dashed #bdc3c7;\r\n  border-radius: 8px;\r\n  margin: 1rem 0;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n}\r\n\r\n.preview-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.upload-label {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  color: #7f8c8d;\r\n}\r\n\r\ninput[type=\"file\"] {\r\n  display: none;\r\n}\r\n\r\nbutton {\r\n  background: #3498db;\r\n  color: white;\r\n  border: none;\r\n  padding: 1rem 2rem;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-size: 1.1rem;\r\n  transition: background 0.3s;\r\n  display: block;\r\n  margin: 0 auto;\r\n}\r\n\r\nbutton:hover {\r\n  background: #2980b9;\r\n}\r\n\r\n.result-section {\r\n  text-align: center;\r\n  margin-top: 2rem;\r\n}\r\n\r\n.result-img {\r\n  max-width: 600px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\r\n  margin: 1rem 0;\r\n}\r\n\r\n.download-btn {\r\n  display: inline-block;\r\n  background: #2ecc71;\r\n  color: white;\r\n  padding: 0.8rem 1.5rem;\r\n  border-radius: 8px;\r\n  text-decoration: none;\r\n  margin-top: 1rem;\r\n  transition: background 0.3s;\r\n}\r\n\r\n.download-btn:hover {\r\n  background: #27ae60;\r\n}\r\n\r\n.loading {\r\n  display: none;\r\n  text-align: center;\r\n  color: #3498db;\r\n  margin: 1rem 0;\r\n}\r\n\r\n.error {\r\n  color: #e74c3c;\r\n  text-align: center;\r\n  margin: 1rem 0;\r\n}\r\n</style>"]}]}
{"remainingRequest":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\Record.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\src\\views\\Record.vue","mtime":1743958813208},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\babel-loader\\lib\\index.js","mtime":1741692719689},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1741692719541},{"path":"D:\\vscodeproject\\ICON_LAB\\vue\\node_modules\\vue-loader\\lib\\index.js","mtime":1741692741778}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Record.vue"],"names":[],"mappings":";AAoEA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Record.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div>\r\n    <!-- 搜索栏 -->\r\n    <div style=\"margin-bottom: 20px\">\r\n      <el-input\r\n          style=\"width: 200px;margin-right: 5px\"\r\n          placeholder=\"按金额搜索\"\r\n          suffix-icon=\"el-icon-search\"\r\n          v-model=\"searchAmount\"\r\n      ></el-input>\r\n      <el-input\r\n          style=\"width: 200px;\"\r\n          placeholder=\"按用户昵称搜索\"\r\n          suffix-icon=\"el-icon-search\"\r\n          v-model=\"searchNickname\"\r\n      ></el-input>\r\n      <el-button class=\"ml-5\" plain type=\"primary\" @click=\"load\">搜索</el-button>\r\n      <el-button type=\"info\" plain @click=\"reset\">重置</el-button>\r\n    </div>\r\n\r\n    <!-- 数据表格 -->\r\n    <el-card>\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\r\n        <el-table-column label=\"用户昵称\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <span v-if=\"scope.row.userId\">\r\n              {{ users.find(v => v.id === scope.row.userId)?.nickname || '未知用户' }}\r\n            </span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"amount\" label=\"充值金额\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            ￥{{ scope.row.amount.toFixed(2) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"points\" label=\"获得积分\" align=\"center\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"状态\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <el-tag :type=\"scope.row.status === 'SUCCESS' ? 'success' : 'danger'\">\r\n              {{ scope.row.status }}\r\n            </el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"createTime\" label=\"充值时间\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            {{ formatTime(scope.row.createTime) }}\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!-- 分页 -->\r\n      <div style=\"padding: 10px 0\">\r\n        <el-pagination\r\n            @size-change=\"handleSizeChange\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :current-page=\"pageNum\"\r\n            :page-sizes=\"[5, 10, 20, 50]\"\r\n            :page-size=\"pageSize\"\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :total=\"total\"\r\n        ></el-pagination>\r\n      </div>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport dayjs from 'dayjs'\r\n\r\nexport default {\r\n  name: \"Record\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      users: [],\r\n      total: 0,\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      searchAmount: \"\", // 搜索条件\r\n      searchNickname: \"\",\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n    this.request.get('/user').then(res => {\r\n      this.users = res.data\r\n    })\r\n  },\r\n  methods: {\r\n    formatTime(time) {\r\n      return time ? dayjs(time).format('YYYY-MM-DD HH:mm') : ''\r\n    },\r\n    // 加载数据\r\n    load() {\r\n      this.request.get(\"/record/page\", {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          amount: this.searchAmount,\r\n          nickname: this.searchNickname,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data.records\r\n        this.total = res.data.total\r\n      })\r\n    },\r\n    // 重置搜索\r\n    reset() {\r\n      this.searchAmount = \"\"\r\n      this.searchNickname = \"\"\r\n      this.load()\r\n    },\r\n    // 分页方法\r\n    handleSizeChange(pageSize) {\r\n      this.pageSize = pageSize\r\n      this.load()\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.pageNum = pageNum\r\n      this.load()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.ml-5 {\r\n  margin-left: 5px;\r\n}\r\n</style>"]}]}